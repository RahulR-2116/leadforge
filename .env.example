APP_NAME=LeadForge
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=sqlite:///./leadforge.db
POSTGRES_USER=leadforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leadforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

VITE_API_BASE_URL=http://localhost:8000

SCRAPER_MAX_CONCURRENCY=2
SCRAPER_DELAY_SECONDS=1.5
SCRAPER_RETRIES=2
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 LeadForgeBot/1.0
SCRAPER_PROXY_URL=
SCRAPER_ADDRESS_SIMILARITY_THRESHOLD=0.88
